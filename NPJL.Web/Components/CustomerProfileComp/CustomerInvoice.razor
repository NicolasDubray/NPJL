@page "/customerInvoice"
@rendermode InteractiveServer
@using NPJL.Application.DTOs.Customers
@using NPJL.Application.DTOs.Invoices
@using NPJL.Application.Services
@using NPJL.Web.Services
@inject InvoiceService InvoiceService
@inject CurrentCustomerService CurrentCustomerService

<div class="container">
    <div class="row justify-content-center">
        <div class="col-12 col-lg-9">
            <h1 class="h1 mb-4 text-center">Invoices</h1>
            @if (errorMessage != null)
            {
                <div class="alert alert-danger">@errorMessage</div>
            }
            @if (invoices != null)
            {
                <h3 class="h4">Pending invoices</h3>
                <div class="card mb-4 shadow-sm">
                    <div class="card-body">
                        <table class="table table-striped table-hover table-bordered">
                            <thead>
                                <tr><th>OCR</th><th>Amount</th><th>Send date</th><th>Expiry date</th><th>Status</th></tr>
                            </thead>
                            <tbody>
                                @foreach (var i in invoices.Where(i => i.Status == "Sent" || i.Status == "Expired")
                                    .OrderByDescending(i => i.SendDate))
                                {
                                    <tr>
                                        <td>@i.OCR</td>
                                        <td>@i.Amount</td>
                                        <td>@i.SendDate?.ToString("yyyy-MM-dd")</td>
                                        <td>@i.ExpiryDate?.ToString("yyyy-MM-dd")</td>
                                        <td>@i.Status</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>

                <h3 class="h4">Invoice history</h3>
                <div class="card mb-4 shadow-sm">
                    <div class="card-body">
                        <table class="table table-striped table-hover table-bordered">
                            <thead>
                                <tr><th>OCR</th><th>Amount</th><th>Send date</th><th>Expiry date</th><th>Status</th></tr>
                            </thead>
                            <tbody>
                                @foreach (var i in invoices.Where(i => i.Status == "Paid")
                                    .OrderByDescending(i => i.SendDate))
                                {
                                    <tr>
                                        <td>@i.OCR</td>
                                        <td>@i.Amount</td>
                                        <td>@i.SendDate?.ToString("yyyy-MM-dd")</td>
                                        <td>@i.ExpiryDate?.ToString("yyyy-MM-dd")</td>
                                        <td>@i.Status</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            }
        </div>
    </div>
</div>

@code {
    private List<InvoiceDto>? invoices;
    private CustomerDto? customer;
    private string? errorMessage;
    protected override async Task OnInitializedAsync()
    {
        try
        {
            customer = await CurrentCustomerService.GetCurrentCustomerAsync();
            if (customer == null) return;
            invoices = await InvoiceService.GetByCustomerIdAsync(customer.Id);
        }
        catch (Exception)
        {
            errorMessage = "Could not load your invoices, please try again";
        }
    }
}