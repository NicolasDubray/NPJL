@using Microsoft.AspNetCore.Components.Authorization
@using NPJL.Web.Services

@inject CustomAuthenticationStateProvider AuthenticationProvider
@inject NavigationManager Navigation

<nav class="universal-menu">

    <!-- Klickyta som stänger Admin-menyn vid klick utanför den -->
    @if (adminMenuOpen)
    {
        <div class="admin-dropdown-overlay"
             @onclick="CloseAdminMenu">
        </div>
    }

    <!-- Hamburgerknapp för mobil -->
    <button class="menu-toggle"
            @onclick="ToggleMenu"
            aria-label="Öppna eller stäng meny"
            aria-expanded="@menuOpen">
        <span></span>
        <span></span>
        <span></span>
    </button>

    <!-- Menylänkar -->
    <div class="menu-links @(menuOpen ? "open" : "")"
         @onclick="CloseAdminMenu">

        <a href="/" @onclick="CloseMenu">Home</a>
        <a href="#Booking" @onclick="CloseMenu">Booking</a>
        <a href="#About" @onclick="CloseMenu">About</a>

        <!-- Kontrollerar om en användare är inloggad -->
        <AuthorizeView>

            <Authorized Context="auth">

                <!-- Kund – visas när kund är inloggad -->
                @if (auth.User.IsInRole("Customer"))
                {
                    <a href="#" @onclick:preventDefault="true">Offers</a>
                    <a href="/customerprofile" @onclick="CloseMenu">Customer Profile</a>
                    <a href="/customerOrders" @onclick="CloseMenu">Orders</a>
                    <a href="/customerInvoice" @onclick="CloseMenu">Invoices</a>
                }

                <!-- Anställd – visas när anställd eller administratör är inloggad -->
                @if (auth.User.IsInRole("Employee") ||
     auth.User.IsInRole("Administrator"))
                {
                    <a href="/my-profile" @onclick="CloseMenu">My Profile</a>
                    <a href="#" @onclick:preventDefault="true">Assigned orders</a>
                }

                <!-- Administratör – samlar administrativa funktioner i en dropdown -->
                @if (auth.User.IsInRole("Administrator"))
                {
                    <div class="admin-dropdown"
                         @onclick:stopPropagation="true">

                        <button type="button"
                                class="admin-dropdown-toggle"
                                @onclick="ToggleAdminMenu"
                                aria-expanded="@adminMenuOpen">
                            Admin
                            <span class="dropdown-arrow">▼</span>
                        </button>

                        @if (adminMenuOpen)
                        {
                            <div class="admin-dropdown-menu">

                                <!-- Personnel management -->
                                <a href="/personnel" @onclick="CloseMenu">
                                    Personnel Register
                                </a>

                                <a href="/personnel/register-employee" @onclick="CloseMenu">
                                    Register New Employee
                                </a>

                                <a href="#" @onclick:preventDefault="true">
                                    Absence Management
                                </a>

                                <a href="#" @onclick:preventDefault="true">
                                    Time Reporting
                                </a>

                                <!-- Customer management -->
                                <a href="#" @onclick:preventDefault="true">
                                    Customer Register
                                </a>

                                <!-- Bookings and sales -->
                                <a href="#" @onclick:preventDefault="true">
                                    Booking Management
                                </a>

                                <a href="#" @onclick:preventDefault="true">
                                    Invoicing
                                </a>

                                <a href="#" @onclick:preventDefault="true">
                                    Quote Requests
                                </a>

                                <a href="#" @onclick:preventDefault="true">
                                    Orders
                                </a>

                                <!-- System administration -->
                                <a href="#" @onclick:preventDefault="true">
                                    User Management
                                </a>

                            </div>
                        }

                    </div>
                }

                <!-- Konto -->
                <span class="logged-in-user">
                    @auth.User.Identity?.Name
                </span>

                <button type="button"
                        class="logout-button"
                        @onclick="Logout">
                    Log out
                </button>

            </Authorized>

            <NotAuthorized>

                <!-- Konto -->
                <a href="/Login" @onclick="CloseMenu">Log in</a>
                <a href="/Register" @onclick="CloseMenu">Register</a>

            </NotAuthorized>

        </AuthorizeView>

    </div>
</nav>

@code {
    // Håller reda på om mobilmenyn är öppen eller stängd.
    private bool menuOpen = false;

    // Håller reda på om administratörsmenyn är öppen eller stängd.
    private bool adminMenuOpen = false;

    // Öppnar eller stänger mobilmenyn.
    private void ToggleMenu()
    {
        menuOpen = !menuOpen;

        if (!menuOpen)
        {
            adminMenuOpen = false;
        }
    }

    // Öppnar eller stänger administratörsmenyn.
    private void ToggleAdminMenu()
    {
        adminMenuOpen = !adminMenuOpen;
    }

    // Stänger endast administratörsmenyn.
    private void CloseAdminMenu()
    {
        adminMenuOpen = false;
    }
    
    // Stänger menyerna när en länk väljs.
    private void CloseMenu()
    {
        menuOpen = false;
        adminMenuOpen = false;
    }
   
    // Loggar ut användaren och återställer autentiseringstillståndet.
    private async Task Logout()
    {
        await AuthenticationProvider.LogoutAsync();

        CloseMenu();

        // Skickar användaren tillbaka till startsidan efter utloggning.
        Navigation.NavigateTo("/");
    }
}
