@implements IDisposable
@using Microsoft.AspNetCore.Components.Authorization
@using NPJL.Web.Services
@using NPJL.Domain.Enums

@inject AuthenticationStateProvider AuthenticationProvider
@inject CustomerRequestApiService CustomerRequestApiService
@inject NavigationManager Navigation
@inject CustomAuthenticationStateProvider CustomAuthProvider

<nav class="universal-menu">

    <!-- Klickyta som stänger Admin-menyn vid klick utanför den -->
    @if (adminMenuOpen)
    {
        <div class="admin-dropdown-overlay"
             @onclick="CloseAdminMenu">
        </div>
    }

    <!-- Hamburgerknapp för mobil -->
    <button class="menu-toggle"
            @onclick="ToggleMenu"
            aria-label="Öppna eller stäng meny"
            aria-expanded="@menuOpen">
        <span></span>
        <span></span>
        <span></span>
    </button>

    <!-- Menylänkar -->
    <div class="menu-links @(menuOpen ? "open" : "")"
         @onclick="CloseAdminMenu">

        <a href="/" @onclick="CloseMenu">Home</a>
        <a href="#Booking" @onclick="CloseMenu">Booking</a>
        <a href="#About" @onclick="CloseMenu">About</a>

        <!-- Kontrollerar om en användare är inloggad -->
        <AuthorizeView>

            <Authorized Context="auth">

                <!-- Kund -->
                @if (auth.User.IsInRole("Customer"))
                {
                    <a href="#" @onclick:preventDefault="true">Offers</a>
                    <a href="/customerprofile" @onclick="CloseMenu">Customer Profile</a>
                    <a href="/customerOrders" @onclick="CloseMenu">Orders</a>
                    <a href="/customerInvoice" @onclick="CloseMenu">Invoices</a>
                }
                
                <!-- Anställd -->
                @if (auth.User.IsInRole("Employee") ||
                     auth.User.IsInRole("Administrator"))
                {
                    <a href="/my-profile" @onclick="CloseMenu">My Profile</a>
                    <a href="#" @onclick:preventDefault="true">Assigned orders</a>
                }

                <!-- Administratör -->
                @if (auth.User.IsInRole("Administrator"))
                {
                    <div class="admin-dropdown"
                         @onclick:stopPropagation="true">

                        <button type="button"
                                class="admin-dropdown-toggle"
                                @onclick="ToggleAdminMenu"
                                aria-expanded="@adminMenuOpen">

                            Admin

                            @if (pendingCustomerRequests > 0)
                            {
                                <span class="admin-count">
                                    @pendingCustomerRequests
                                </span>
                            }

                            <span class="dropdown-arrow">▼</span>
                        </button>

                        @if (adminMenuOpen)
                        {
                            <div class="admin-dropdown-menu">

                                <!-- Personnel management -->
                                <a href="/personnel" @onclick="CloseMenu">
                                    Personnel Register
                                </a>

                                <!-- Customer requests -->
                                <a href="/admin/customer-requests"
                                   @onclick="CloseMenu">

                                    Customer Requests

                                    @if (pendingCustomerRequests > 0)
                                    {
                                        <span class="admin-count">
                                            @pendingCustomerRequests
                                        </span>
                                    }
                                </a>

                                <a href="/personnel/register-employee"
                                   @onclick="CloseMenu">
                                    Register New Employee
                                </a>
                               
                                <a href="#" @onclick:preventDefault="true">
                                    Time Reporting
                                </a>

                                <!-- Customer management -->
                                <a href="#" @onclick:preventDefault="true">
                                    Customer Register
                                </a>
                                
                                <!-- Bookings and sales -->
                                <a href="#" @onclick:preventDefault="true">
                                    Booking Management
                                </a>

                                <a href="#" @onclick:preventDefault="true">
                                    Invoicing
                                </a>

                                <a href="#" @onclick:preventDefault="true">
                                    Quote Requests
                                </a>

                                <a href="#" @onclick:preventDefault="true">
                                    Orders
                                </a>

                                

                            </div>
                        }

                    </div>
                }

                <!-- Konto -->
                <span class="logged-in-user">
                    @auth.User.Identity?.Name
                </span>

                <button type="button"
                        class="logout-button"
                        @onclick="Logout">
                    Log out
                </button>

            </Authorized>

            <NotAuthorized>

                <!-- Konto -->
                <a href="/Login" @onclick="CloseMenu">Log in</a>
                <a href="/Register" @onclick="CloseMenu">Register</a>

            </NotAuthorized>

        </AuthorizeView>

    </div>
</nav>

@code {

    // Håller reda på om mobilmenyn är öppen eller stängd.
    private bool menuOpen = false;

    // Håller reda på om administratörsmenyn är öppen eller stängd.
    private bool adminMenuOpen = false;

    // Antal kundförfrågningar som väntar på behandling.
    private int pendingCustomerRequests = 0;

    // Hämtar antalet väntande kundförfrågningar för administratörer.
    protected override void OnInitialized()
    {
        CustomAuthProvider.AuthenticationStateChanged +=
            OnAuthenticationStateChanged;
    }

    private async void OnAuthenticationStateChanged(
        Task<AuthenticationState> task)
    {
        var authState = await task;
        var user = authState.User;

        if (!user.IsInRole("Administrator"))
        {
            pendingCustomerRequests = 0;
            await InvokeAsync(StateHasChanged);
            return;
        }

        await LoadCustomerRequests();
    }

    private async Task LoadCustomerRequests()
    {
        try
        {
            var requests = await CustomerRequestApiService.GetAllAsync();

            pendingCustomerRequests = requests.Count(
                request => request.Status == CustomerRequestStatus.InReview);
        }
        catch (Exception)
        {
            pendingCustomerRequests = 0;
        }

        await InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        CustomAuthProvider.AuthenticationStateChanged -=
            OnAuthenticationStateChanged;
    }

    // Öppnar eller stänger mobilmenyn.
    private void ToggleMenu()
    {
        menuOpen = !menuOpen;

        if (!menuOpen)
        {
            adminMenuOpen = false;
        }
    }

    // Öppnar eller stänger administratörsmenyn.
    private void ToggleAdminMenu()
    {
        adminMenuOpen = !adminMenuOpen;
    }

    // Stänger endast administratörsmenyn.
    private void CloseAdminMenu()
    {
        adminMenuOpen = false;
    }
    
    // Stänger menyerna när en länk väljs.
    private void CloseMenu()
    {
        menuOpen = false;
        adminMenuOpen = false;
    }

    // Loggar ut användaren och återställer autentiseringstillståndet.
    private async Task Logout()
    {
        await CustomAuthProvider.LogoutAsync();

        CloseMenu();

        // Skickar användaren tillbaka till startsidan efter utloggning.
        Navigation.NavigateTo("/");
    }
}
