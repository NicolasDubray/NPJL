@using Microsoft.AspNetCore.Components.Authorization
@using NPJL.Web.Services

@inject CustomAuthenticationStateProvider AuthenticationProvider
@inject NavigationManager Navigation

<nav class="universal-menu">

    <!-- Hamburgerknapp för mobil -->
    <button class="menu-toggle"
            @onclick="ToggleMenu"
            aria-label="Öppna eller stäng meny"
            aria-expanded="@menuOpen">
        <span></span>
        <span></span>
        <span></span>
    </button>
    
    <!-- Menylänkar -->
    <div class="menu-links @(menuOpen ? "open" : "")">

        <a href="/" @onclick="CloseMenu">Home</a>
        <a href="#Booking" @onclick="CloseMenu">Booking</a>
        <a href="#About" @onclick="CloseMenu">About</a>

        <!-- Kontrollerar om en användare är inloggad -->
        <AuthorizeView>

            <Authorized Context="auth">

                <!-- Kund – visas när kund är inloggad -->
                @if (auth.User.IsInRole("Customer"))
                {
                    <a href="#" @onclick:preventDefault="true">Offers</a>
                    <a href="#" @onclick:preventDefault="true">Active orders</a>
                    <a href="#" @onclick:preventDefault="true">Pending invoices</a>
                }

                <!-- Anställd – visas när anställd eller administratör är inloggad -->
                @if (auth.User.IsInRole("Employee") ||
                    auth.User.IsInRole("Administrator"))
                {
                    <a href="#" @onclick:preventDefault="true">Assigned orders</a>
                }

                <!-- Administratör – visas när administratör är inloggad -->
                @if (auth.User.IsInRole("Administrator"))
                {
                    <a href="#" @onclick:preventDefault="true">Orders</a>
                    <a href="#" @onclick:preventDefault="true">Add customers</a>
                }

                <!-- Konto -->
                <span class="logged-in-user">
                    @auth.User.Identity?.Name
                </span>

                <button type="button"
                        class="logout-button"
                        @onclick="Logout">
                    Log out
                </button>

            </Authorized>

            <NotAuthorized>

                <!-- Konto -->
                <a href="/Login" @onclick="CloseMenu">Log in</a>
                <a href="/Register" @onclick="CloseMenu">Register</a>

            </NotAuthorized>

        </AuthorizeView>

    </div>
</nav>

@code {
    // Håller reda på om mobilmenyn är öppen eller stängd.
    private bool menuOpen = false;

    // Öppnar eller stänger mobilmenyn.
    private void ToggleMenu()
    {
        menuOpen = !menuOpen;
    }

    // Stänger mobilmenyn när en länk väljs.
    private void CloseMenu()
    {
        menuOpen = false;
    }

    // Loggar ut användaren och återställer autentiseringstillståndet.
    private async Task Logout()
    {
        await AuthenticationProvider.LogoutAsync();

        CloseMenu();

        // Skickar användaren tillbaka till startsidan efter utloggning.
        Navigation.NavigateTo("/");
    }
}