@page "/register"
@using NPJL.Application.DTOs.Authentication
@using System.Net.Http.Json
@using NPJL.Web.Services
@inject AuthService AuthService
<PageTitle>Customer Registration - The Office</PageTitle>

<div class="register-container">

    <h1>Customer Registration</h1>
    
    <p>Create an account to book services and manage your work orders.</p>

    <EditForm Model="@registration"
              OnValidSubmit="RegisterCustomer"
              FormName="CustomerRegistration">

        <DataAnnotationsValidator />
        <ValidationSummary />
        
        <div class="form-group">
            <label>Email</label>
            <InputText @bind-Value="registration.Email" class="form-control" />
            <ValidationMessage For="@(() => registration.Email)" />
        </div>

        <div class="form-group">
            <label>First name</label>
            <InputText @bind-Value="registration.FirstName" class="form-control" />
            <ValidationMessage For="@(() => registration.FirstName)" />
        </div>

        <div class="form-group">
            <label>Last name</label>
            <InputText @bind-Value="registration.LastName" class="form-control" />
            <ValidationMessage For="@(() => registration.LastName)" />
        </div>

        <div class="form-group">
            <label>Customer type</label>
            <InputCheckbox @bind-Value="registration.IsCompany" />
            <span>Register as a company</span>
        </div>

        @if (registration.IsCompany)
        {
            <div class="form-group">
                <label>Company name</label>
                <InputText @bind-Value="registration.CompanyName" class="form-control" />
            </div>
        }

        <div class="form-group">
            <label>Address</label>
            <InputText @bind-Value="registration.Address" class="form-control" />
            <ValidationMessage For="@(() => registration.Address)" />
        </div>

        <div class="form-group">
            <label>Telephone</label>
            <InputText @bind-Value="registration.Telephone" class="form-control" />
            <ValidationMessage For="@(() => registration.Telephone)" />
        </div>

        <div class="form-group">
            <label>Password</label>
            <InputText type="password"
                       @bind-Value="registration.Password"
                       class="form-control" />
            <ValidationMessage For="@(() => registration.Password)" />
        </div>

        <button type="submit" class="btn btn-primary">
            Create account
        </button>

    </EditForm>
    @if (!string.IsNullOrWhiteSpace(message))
    {
        <p>@message</p>
    }
</div>

@code {
    private CustomerRegistrationDto registration = new();

    private string message = string.Empty;

    private async Task RegisterCustomer()
    {
        try
        {
            var response = await AuthService.RegisterCustomerAsync(
                registration);

            var result = await response.Content
                .ReadFromJsonAsync<CustomerRegistrationResultDto>();

            if (response.IsSuccessStatusCode && result?.Succeeded == true)
            {
                message = "Your account has been created successfully!";
                registration = new CustomerRegistrationDto();
            }
            else
            {
                message = result?.Message ?? "Registration failed.";
            }
        }
        catch (HttpRequestException)
        {
            message = "Could not connect to the server. Please try again.";
        }
    }
}