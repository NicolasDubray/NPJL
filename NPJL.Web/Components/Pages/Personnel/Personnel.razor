@page "/personnel"

@using Microsoft.AspNetCore.Components.Authorization
@using NPJL.Application.DTOs.Employees
@using NPJL.Web.Services

@inject EmployeeApiService EmployeeApiService

<PageTitle>Personnel Register</PageTitle>

<AuthorizeView Roles="Administrator">
    <Authorized>

        <div class="personnel-page">

            <div class="page-heading">
                <div>
                    <h1>Personnel Register</h1>
                    <p>Overview of the company's employees.</p>
                </div>

                <button type="button" class="add-employee-button">
                    + Add Employee
                </button>
            </div>

            @if (isLoading)
            {
                <p class="status-message">Fetching employee information...</p>
            }
            else if (!string.IsNullOrEmpty(errorMessage))
            {
                <p class="error-message">@errorMessage</p>
            }
            else if (employees.Count == 0)
            {
                <p class="status-message">There are no registered employees.</p>
            }
            else
            {
                <div class="personnel-summary">
                    <span>
                        Total employees:
                        <strong>@employees.Count</strong>
                    </span>

                    <span>
                        Active:
                        <strong>@employees.Count(e => e.IsActive)</strong>
                    </span>
                </div>

                <!-- Sökning och statusfilter -->
                <div class="personnel-search">

                    <input type="search"
                           placeholder="Search by name or personal number..."
                           @bind="searchText"
                           @bind:event="oninput" />

                    <select @bind="statusFilter">
                        <option value="All">All employees</option>
                        <option value="Active">Active</option>
                        <option value="Inactive">Inactive</option>
                    </select>

                </div>

                @if (filteredEmployees.Count == 0)
                {
                    <p class="status-message">
                        
                        No employees matched your search criteria.
                    </p>
                }
                else
                {
                    <div class="table-container">
                        <table class="personnel-table">
                            <thead>
                                <tr>
                                    <th>Name</th>
                                    <th>
                                        Personal identity number
                                    </th>
                                    <th>
                                        Vacation days
                                    </th>
                                    <th>Status</th>
                                </tr>
                            </thead>

                            <tbody>
                                @foreach (var employee in filteredEmployees)
                                {
                                    <tr>
                                        <td>
                                            <a href="@($"/personnel/{employee.Id}")">
                                                @employee.FirstName @employee.LastName
                                            </a>
                                        </td>
                                        <td>@employee.SSN</td>
                                        <td>@employee.VacationDays</td>
                                        <td>
                                            @if (employee.IsActive)
                                            {
                                                <span class="employee-status active">
                                                    Aktiv
                                                </span>
                                            }
                                            else
                                            {
                                                <span class="employee-status inactive">
                                                    Inaktiv
                                                </span>
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            }

        </div>

    </Authorized>

    <NotAuthorized>
        <div class="personnel-page">
            <h1>
                Access denied
            </h1>
            <p>
                You need administrator privileges
                to view the personnel registry.
            </p>
        </div>
    </NotAuthorized>

    <Authorizing>
        <div class="personnel-page">
            <p class="status-message">Checking permissions...</p>
        </div>
    </Authorizing>

</AuthorizeView>

@code {
    private List<EmployeeDto> employees = new();

    private bool isLoading = true;
    private string? errorMessage;

    // Innehåller texten som administratören skriver i sökfältet.
    private string searchText = string.Empty;

    // Anger vilket statusfilter som är valt.
    private string statusFilter = "All";

    // Filtrerar personalregistret utifrån söktext och status.
    private List<EmployeeDto> filteredEmployees =>
        employees
            .Where(e =>
                // Kontrollerar söktexten.
                (
                    string.IsNullOrWhiteSpace(searchText) ||
                    $"{e.FirstName} {e.LastName}"
                        .Contains(searchText, StringComparison.OrdinalIgnoreCase) ||
                    e.SSN.Contains(searchText, StringComparison.OrdinalIgnoreCase)
                )
                &&
                // Kontrollerar vald status.
                (
                    statusFilter == "All" ||
                    (statusFilter == "Active" && e.IsActive) ||
                    (statusFilter == "Inactive" && !e.IsActive)
                )
            )
            .ToList();
    
    // Hämtar personaluppgifter när sidan öppnas.
    protected override async Task OnInitializedAsync()
    {
        try
        {
            employees = (await EmployeeApiService.GetAllAsync()).ToList();
        }
        catch (HttpRequestException)
        {
            errorMessage = "Could not reach the server.Check the API connection.";
        }
        catch (Exception)
        {
            errorMessage = "An unexpected error occurred while retrieving the personnel data.";
        }
        finally
        {
            isLoading = false;
        }
    }
}
