@page "/personnel/{Id:int}"
@page "/my-profile"

@using Microsoft.AspNetCore.Components.Authorization
@using NPJL.Application.DTOs.Employees
@using NPJL.Web.Services
@using System.Net
@using Microsoft.Extensions.Options
@using NPJL.Web.Configuration
@using NPJL.Application.DTOs.Absentisms
@using NPJL.Domain.Enums
@using System.Security.Claims

@inject IOptions<TaxSettings> TaxSettings
@inject EmployeeApiService EmployeeApiService
@inject AbsentismApiService AbsentismApiService
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject ContactInfoApiService ContactInfoApiService
@inject NavigationManager NavigationManager
@inject BankInfoApiService BankInfoApiService
@inject TimeReportApiService TimeReportApiService
@inject SalaryApiService SalaryApiService

<PageTitle>Employee Details</PageTitle>

<AuthorizeView>
    <Authorized>
        <div class="personnel-page">
            
            @if (isLoading)
            {
                <p>Fetching employee information...</p>
            }
            else if (!string.IsNullOrEmpty(errorMessage))
            {
                <p class="error-message">@errorMessage</p>
            }
            else if (employee != null)
            {
                <div class="page-heading">
                    <div>
                        <h1>@employee.FirstName @employee.LastName</h1>
                        <p>Detailed employee information</p>
                    </div>
                </div>

                
                <section>
                    <h2>Basic Information</h2>

                    <p><strong>Personal Identity Number:</strong> @employee.SSN</p>
                    <p><strong>Vacation Days:</strong> @employee.VacationDays</p>

                    @if (isAdministrator)
                    {
                        @if (!isEditingVacationDays)
                        {
                            <button type="button"
                                    class="absence-edit-button"
                                    @onclick="StartEditingVacationDays">
                                Edit Vacation Days
                            </button>
                        }
                        else
                        {
                            <EditForm Model="vacationDaysForm"
                                      OnValidSubmit="SaveVacationDaysAsync"
                                      Context="vacationDaysContext"
                                      class="absence-form">

                                <div>
                                    <label>Vacation Days</label>
                                    <InputNumber @bind-Value="vacationDaysForm.VacationDays" />
                                </div>

                                <button type="submit"
                                        class="absence-edit-button"
                                        disabled="@isSavingVacationDays">
                                    @(isSavingVacationDays ? "Saving..." : "Save Changes")
                                </button>

                                <button type="button"
                                        class="absence-cancel-button"
                                        disabled="@isSavingVacationDays"
                                        @onclick="CancelEditingVacationDays">
                                    Cancel
                                </button>
                            </EditForm>
                        }
                    }

                    @if (!string.IsNullOrEmpty(vacationDaysMessage))
                    {
                        <p class="success-message">@vacationDaysMessage</p>
                    }

                    @if (!string.IsNullOrEmpty(vacationDaysErrorMessage))
                    {
                        <p class="error-message">@vacationDaysErrorMessage</p>
                    }

                    <div>
                        <p>
                            <strong>Status:</strong>
                            @(employee.IsActive ? "Active" : "Inactive")
                        </p>

                        @if (isAdministrator)
                        {
                            @if (!isEditingEmployeeStatus)
                            {
                                <button type="button"
                                        class="absence-edit-button"
                                        @onclick="StartEditingEmployeeStatus">
                                    Edit Status
                                </button>
                            }
                            else
                            {
                                <EditForm Model="employeeStatusForm"
                                          OnValidSubmit="SaveEmployeeStatusAsync"
                                          Context="employeeStatusContext"
                                          class="absence-form">

                                    <div>
                                        <label>Employee Status</label>

                                        <InputSelect @bind-Value="employeeStatusForm.IsActive">
                                            <option value="true">Active</option>
                                            <option value="false">Inactive</option>
                                        </InputSelect>
                                    </div>

                                    <button type="submit"
                                            class="absence-edit-button"
                                            disabled="@isSavingEmployeeStatus">
                                        @(isSavingEmployeeStatus ? "Saving..." : "Save Changes")
                                    </button>

                                    <button type="button"
                                            class="absence-cancel-button"
                                            disabled="@isSavingEmployeeStatus"
                                            @onclick="CancelEditingEmployeeStatus">
                                        Cancel
                                    </button>
                                </EditForm>
                            }
                        }
                    </div>

                    @if (!string.IsNullOrEmpty(employeeStatusMessage))
                    {
                        <p class="success-message">@employeeStatusMessage</p>
                    }

                    @if (!string.IsNullOrEmpty(employeeStatusErrorMessage))
                    {
                        <p class="error-message">@employeeStatusErrorMessage</p>
                    }
                </section>


                
                    <section>
                        <h2>Contact Information</h2>

                        @if (employee.ContactInfos.Count == 0)
                        {
                            <p>No contact information registered.</p>
                        }
                        else
                        {
                            @foreach (var contact in employee.ContactInfos)
                            {
                                <div>
                                    <p><strong>Address:</strong> @contact.Address</p>
                                    <p><strong>Phone:</strong> @contact.Telephone</p>
                                    <p><strong>Email:</strong> @contact.Email</p>

                                    @if (isAdministrator || isMyProfilePage)
                                    {
                                        <button type="button"
                                        class="absence-edit-button"
                                        @onclick="() => StartEditingContactInfo(contact)">
                                            Edit
                                        </button>
                                    }

                                    @if (editingContactInfoId == contact.Id)
                                    {
                                        <EditForm Model="contactInfoForm"
                                        OnValidSubmit="SaveContactInfoAsync"
                                        Context="contactEditContext"
                                        class="absence-form">

                                            <h3>Edit Contact Information</h3>

                                            <div>
                                                <label>Address</label>
                                                <InputText @bind-Value="contactInfoForm.Address" />
                                            </div>

                                            <div>
                                                <label>Phone</label>
                                                <InputText @bind-Value="contactInfoForm.Telephone" />
                                            </div>

                                            <div>
                                                <label>Email</label>
                                                <InputText @bind-Value="contactInfoForm.Email" />
                                            </div>

                                            <button type="submit"
                                            class="absence-edit-button"
                                            disabled="@isSavingContactInfo">
                                                @(isSavingContactInfo ? "Saving..." : "Save Changes")
                                            </button>

                                            <button type="button"
                                            class="absence-cancel-button"
                                            disabled="@isSavingContactInfo"
                                            @onclick="CancelEditingContactInfo">
                                                Cancel
                                            </button>
                                        </EditForm>
                                    }
                                </div>
                            }
                        }

                    @if ((isAdministrator || isMyProfilePage)
&& employee.ContactInfos.Count == 0
&& !isCreatingContactInfo)
                        {
                            <button type="button"
                            class="absence-edit-button"
                            @onclick="StartCreatingContactInfo">
                                Add Contact Information
                            </button>
                        }

                        @if (isCreatingContactInfo)
                        {
                            <EditForm Model="contactInfoForm"
                            OnValidSubmit="CreateContactInfoAsync"
                            Context="newContactContext"
                            class="absence-form">

                                <h3>New Contact Information</h3>

                                <div>
                                    <label>Address</label>
                                    <InputText @bind-Value="contactInfoForm.Address" />
                                </div>

                                <div>
                                    <label>Phone</label>
                                    <InputText @bind-Value="contactInfoForm.Telephone" />
                                </div>

                                <div>
                                    <label>Email</label>
                                    <InputText @bind-Value="contactInfoForm.Email" />
                                </div>

                                <button type="submit"
                                class="absence-edit-button"
                                disabled="@isSubmittingContactInfo">
                                    @(isSubmittingContactInfo ? "Saving..." : "Save Contact Information")
                                </button>

                                <button type="button"
                                class="absence-cancel-button"
                                disabled="@isSubmittingContactInfo"
                                @onclick="CancelCreatingContactInfo">
                                    Cancel
                                </button>
                            </EditForm>
                        }

                        @if (!string.IsNullOrEmpty(contactInfoMessage))
                        {
                            <p class="success-message">@contactInfoMessage</p>
                        }

                        @if (!string.IsNullOrEmpty(contactInfoErrorMessage))
                        {
                            <p class="error-message">@contactInfoErrorMessage</p>
                        }
                    </section>

                    <section>
                        <h2>Employment History</h2>

                        @if (employee.Employments.Count == 0)
                        {
                            <p>No employment information registered.</p>
                        }
                        else
                        {
                            @foreach (var employment in employee.Employments)
                            {
                                <div>
                                    <p><strong>Employment Type:</strong> @employment.HireType</p>
                                    <p><strong>Hire Date:</strong> @employment.HireDate.ToShortDateString()</p>
                                    <p><strong>Role:</strong> @employment.Role</p>
                                    <p><strong>Department:</strong> @employment.Department</p>
                                    <p><strong>Contracted Working Hours per Week:</strong> @employment.NumWorkingHours</p>
                                </div>
                            }
                        }
                    </section>
                    
                <section>
                    <h2>Salary Information</h2>
                    @if (isAdministrator)
                    {
                        @if (!isEditingSalary)
                        {
                            <button type="button"
                                    class="absence-edit-button"
                                    @onclick="StartEditingSalary">
                                Register New Salary
                            </button>
                        }
                        else
                        {
                            <EditForm Model="salaryForm"
                                      OnValidSubmit="SaveSalaryAsync"
                                      Context="salaryContext">
                                <DataAnnotationsValidator />
                                
                                <div>
                                    <label>Salary Amount (SEK)</label>
                                    <InputNumber @bind-Value="salaryForm.Amount" />
                                </div>

                                <div>
                                    <label>Valid From</label>
                                    <InputDate @bind-Value="salaryForm.ValidFrom" />
                                </div>

                                <div>
                                    <label>Valid To (optional)</label>
                                    <InputDate @bind-Value="salaryForm.ValidTo" />
                                </div>

                                <button type="submit"
                                        class="absence-edit-button"
                                        disabled="@isSavingSalary">
                                    @(isSavingSalary ? "Saving..." : "Save Salary")
                                </button>

                                <button type="button"
                                        class="absence-cancel-button"
                                        @onclick="CancelEditingSalary"
                                        disabled="@isSavingSalary">
                                    Cancel
                                </button>
                            </EditForm>
                        }
                    }

                    @if (!string.IsNullOrWhiteSpace(salaryMessage))
                    {
                        <p>@salaryMessage</p>
                    }

                    @if (!string.IsNullOrWhiteSpace(salaryErrorMessage))
                    {
                        <p>@salaryErrorMessage</p>
                    }
                    @if (employee.Salaries.Count == 0)
                    {
                        <p>No salary information registered.</p>
                    }
                    else
                    {
                        @foreach (var salary in employee.Salaries.OrderByDescending(s => s.ValidFrom))
                        {
                            <div>
                                <p><strong>Salary Amount:</strong> @salary.Amount.ToString("N2") SEK</p>
                                <p><strong>Valid From:</strong> @salary.ValidFrom.ToShortDateString()</p>
                                <p>
                                    <strong>Valid To:</strong>
                                    @(salary.ValidTo?.ToShortDateString() ?? "Ongoing")
                                </p>
                                <p><strong>Registered:</strong> @salary.CreatedAt.ToShortDateString()</p>
                            </div>
                        }
                    }
                    
                </section>
                    <section>
                        <h2>Tax Information</h2>

                        <p>
                            <strong>Tax Rate:</strong>
                            @TaxSettings.Value.TaxRatePercent.ToString("F2") %
                        </p>

                        <p>
                            <strong>Tax Type:</strong> Standard tax rate
                        </p>

                        <p>
                            <strong>Tax Calculation:</strong> Estimated
                        </p>
                    </section>
                <section>
                    <h2>Banking Details</h2>

                    @if (!string.IsNullOrWhiteSpace(bankInfoMessage))
                    {
                        <p>@bankInfoMessage</p>
                    }

                    @if (!string.IsNullOrWhiteSpace(bankInfoErrorMessage))
                    {
                        <p class="error-message">@bankInfoErrorMessage</p>
                    }

                    @if (employee.BankInfos.Count == 0)
                    {
                        <p>No banking details registered.</p>
                    }
                    else
                    {
                        @foreach (var bank in employee.BankInfos)
                        {
                            <div>
                                <p><strong>Account Holder:</strong> @bank.AccountHolderName</p>
                                <p><strong>Account Holder Type:</strong> @bank.AccountHolderType</p>
                                <p><strong>Bank:</strong> @bank.BankName</p>
                                <p><strong>Clearing Number:</strong> @bank.ClearingNumber</p>
                                <p><strong>Account Number:</strong> @bank.BankAccountNumber</p>
                                
                                @if (isAdministrator || isMyProfilePage)
                                {
                                    @if (editingBankInfoId != bank.Id)
                                    {
                                        <button type="button"
                                                class="absence-edit-button"
                                                @onclick="() => StartEditingBankInfo(bank)">
                                            Edit
                                        </button>
                                    }
                                }

                                @if (editingBankInfoId == bank.Id)
                                {
                                    <EditForm Model="bankInfoForm"
                                              OnValidSubmit="SaveBankInfoAsync"
                                              Context="bankEditContext">
                                        <div class="absence-form">
                                            <label>Account Holder Name</label>
                                            <InputText @bind-Value="bankInfoForm.AccountHolderName" />
                                            
                                            <label>Account Holder Type</label>
                                            <InputSelect @bind-Value="bankInfoForm.AccountHolderType">
                                                <option value="@AccountHolderType.Individual">Individual</option>
                                                <option value="@AccountHolderType.Company">Company</option>
                                            </InputSelect>

                                            <label>Bank Name</label>
                                            <InputText @bind-Value="bankInfoForm.BankName" />

                                            <label>Clearing Number</label>
                                            <InputText @bind-Value="bankInfoForm.ClearingNumber" />

                                            <label>Account Number</label>
                                            <InputText @bind-Value="bankInfoForm.BankAccountNumber" />

                                            <button type="submit"
                                                    class="absence-edit-button"
                                                    disabled="@isSavingBankInfo">
                                                @(isSavingBankInfo ? "Saving..." : "Save Changes")
                                            </button>

                                            <button type="button"
                                                    class="absence-cancel-button"
                                                    @onclick="CancelEditingBankInfo">
                                                Cancel
                                            </button>
                                        </div>
                                    </EditForm>
                                }
                            </div>
                        }
                    }

                    @if ((isAdministrator || isMyProfilePage)
                       && employee.BankInfos.Count == 0
                       && !isCreatingBankInfo)
                    {
                        <button type="button"
                                class="absence-edit-button"
                                @onclick="StartCreatingBankInfo">
                            Add Banking Details
                        </button>
                    }
                    
                    @if (isCreatingBankInfo)
                    {
                        <EditForm Model="bankInfoForm"
                                  OnValidSubmit="CreateBankInfoAsync"
                                  Context="bankCreateContext">
                            <div class="absence-form">
                                <h3>New Banking Details</h3>

                                <label>Account Holder Name</label>
                                <InputText @bind-Value="bankInfoForm.AccountHolderName" />

                                <label>Account Holder Type</label>
                                <InputSelect @bind-Value="bankInfoForm.AccountHolderType">
                                    <option value="@AccountHolderType.Individual">Individual</option>
                                    <option value="@AccountHolderType.Company">Company</option>
                                </InputSelect>

                                <label>Bank Name</label>
                                <InputText @bind-Value="bankInfoForm.BankName" />

                                <label>Clearing Number</label>
                                <InputText @bind-Value="bankInfoForm.ClearingNumber" />

                                <label>Account Number</label>
                                <InputText @bind-Value="bankInfoForm.BankAccountNumber" />

                                <button type="submit"
                                        class="absence-edit-button"
                                        disabled="@isSubmittingBankInfo">
                                    @(isSubmittingBankInfo ? "Saving..." : "Create Banking Details")
                                </button>

                                <button type="button"
                                        class="absence-cancel-button"
                                        @onclick="CancelCreatingBankInfo">
                                    Cancel
                                </button>
                            </div>
                        </EditForm>
                    }
                </section>




                    <section>
                        <h2>Absence History</h2>

                        @if (employee.Absentisms.Count == 0)
                        {
                            <p>No absence information registered.</p>
                        }
                        else
                        {
                            @foreach (var absence in employee.Absentisms.OrderByDescending(a => a.StartTime))
                            {
                                <div>
                                    <p><strong>Type:</strong> @absence.Type</p>
                                    <p><strong>From:</strong> @absence.StartTime.ToString("g")</p>
                                    <p><strong>To:</strong> @absence.EndTime.ToString("g")</p>

                                    @if (isAdministrator ||
                                                                                                    (absence.StartTime > DateTime.Now &&
                                                                                                    (absence.Type == AbsentismType.Sick ||
                                                                                                     absence.Type == AbsentismType.CareOfSickChild)))
                                    {
                                        <button type="button"
                                        class="absence-edit-button"
                                        @onclick="() => StartEditingAbsence(absence)">
                                            Edit
                                        </button>
                                    }

                                    @if (isAdministrator)
                                    {
                                        <button type="button"
                                        class="absence-delete-button"
                                        disabled="@isDeletingAbsence"
                                        @onclick="() => ConfirmDeleteAbsence(absence.Id)">
                                            Delete
                                        </button>

                                        @if (confirmingDeleteAbsenceId == absence.Id)
                                        {
                                            <div class="delete-confirmation">
                                                <p>Are you sure you want to delete this absence entry?</p>

                                                <button type="button"
                                                class="absence-confirm-button"
                                                disabled="@isDeletingAbsence"
                                                @onclick="() => DeleteAbsenceAsync(absence.Id)">
                                                    @(isDeletingAbsence ? "Deleting..." : "Confirm Delete")
                                                </button>

                                                <button type="button"
                                                class="absence-cancel-button"
                                                disabled="@isDeletingAbsence"
                                                @onclick="CancelDeleteAbsence">
                                                    Cancel
                                                </button>
                                            </div>
                                        }
                                    }

                                    @if (editingAbsenceId == absence.Id)
                                    {
                                        <EditForm Model="editAbsenceForm"
                                        OnValidSubmit="UpdateAbsenceAsync"
                                        Context="absenceEditContext"
                                        class="absence-form">

                                            <h3>Edit Absence</h3>

                                            <div>
                                                <label>Absence Type</label>
                                                <InputSelect @bind-Value="editAbsenceForm.Type">
                                                    <option value="@AbsentismType.Sick">
                                                        Sick Leave
                                                    </option>

                                                    <option value="@AbsentismType.CareOfSickChild">
                                                        Care of Sick Child (VAB)
                                                    </option>

                                                    @if (isAdministrator)
                                                    {
                                                        <option value="@AbsentismType.Vacation">
                                                            Vacation
                                                        </option>

                                                        <option value="@AbsentismType.ParentalLeave">
                                                            Parental Leave
                                                        </option>
                                                    }
                                                </InputSelect>
                                            </div>

                                            <div>
                                                <label>Start Date and Time</label>
                                                <InputDate @bind-Value="editAbsenceForm.StartTime"
                                                Type="InputDateType.DateTimeLocal" />
                                            </div>

                                            <div>
                                                <label>End Date and Time</label>
                                                <InputDate @bind-Value="editAbsenceForm.EndTime"
                                                Type="InputDateType.DateTimeLocal" />
                                            </div>

                                            <button type="submit"
                                            class="absence-edit-button"
                                            disabled="@isUpdatingAbsence">
                                                @(isUpdatingAbsence ? "Saving..." : "Save Changes")
                                            </button>

                                            <button type="button"
                                            class="absence-cancel-button"
                                            disabled="@isUpdatingAbsence"
                                            @onclick="CancelEditingAbsence">
                                                Cancel
                                            </button>
                                        </EditForm>
                                    }
                                </div>
                            }
                        }

                        @if (!string.IsNullOrEmpty(editAbsenceMessage))
                        {
                            <p class="success-message">@editAbsenceMessage</p>
                        }

                        @if (!string.IsNullOrEmpty(editAbsenceErrorMessage))
                        {
                            <p class="error-message">@editAbsenceErrorMessage</p>
                        }

                        <h3>Register Absence</h3>

                        <EditForm Model="absenceForm"
                        OnValidSubmit="RegisterAbsenceAsync"
                        Context="editFormContext"
                        class="absence-form">

                            <div>
                                <label>Absence Type</label>
                                <InputSelect @bind-Value="absenceForm.Type">
                                    <option value="@AbsentismType.Sick">
                                        Sick Leave
                                    </option>

                                    <option value="@AbsentismType.CareOfSickChild">
                                        Care of Sick Child (VAB)
                                    </option>

                                    @if (isAdministrator)
                                    {
                                        <option value="@AbsentismType.Vacation">
                                            Vacation
                                        </option>

                                        <option value="@AbsentismType.ParentalLeave">
                                            Parental Leave
                                        </option>
                                    }
                                </InputSelect>
                            </div>

                            <div>
                                <label>Start Date and Time</label>
                                <InputDate @bind-Value="absenceForm.StartTime"
                                Type="InputDateType.DateTimeLocal" />
                            </div>

                            <div>
                                <label>End Date and Time</label>
                                <InputDate @bind-Value="absenceForm.EndTime"
                                Type="InputDateType.DateTimeLocal" />
                            </div>

                            @if (!string.IsNullOrEmpty(absenceMessage))
                            {
                                <p class="success-message">@absenceMessage</p>
                            }
                        
                            @if (!string.IsNullOrEmpty(absenceErrorMessage))
                            {
                                <p class="error-message">@absenceErrorMessage</p>
                            }

                            <button type="submit"
                            class="absence-edit-button"
                            disabled="@isSubmittingAbsence">
                                @(isSubmittingAbsence ? "Registering..." : "Register Absence")
                            </button>
                        </EditForm>
                    </section>




                <section>
                    <h2>Time Reports</h2>

                    @if (timeReportMessage is not null)
                    {
                        <p class="text-success">@timeReportMessage</p>
                    }

                    @if (timeReportErrorMessage is not null)
                    {
                        <p class="text-danger">@timeReportErrorMessage</p>
                    }

                    @if (isAdministrator || isMyProfilePage)
                    {
                        <button class="time-report-button"
                                @onclick="StartCreatingTimeReport"
                                disabled="@isSubmittingTimeReport">
                            Register Time Report
                        </button>
                    }
                    
                    @if (isCreatingTimeReport)
                    {
                        <EditForm Model="timeReportForm"
                                  OnValidSubmit="CreateTimeReportAsync"
                                  Context="timeReportCreateContext">

                            <DataAnnotationsValidator />
                            <ValidationSummary />

                            <div class="mb-3">
                                <label class="form-label">Order Number</label>
                                <InputNumber class="form-control"
                                             @bind-Value="timeReportForm.BookingId" />
                            </div>

                            <div class="mb-3">
                                <label class="form-label">Start Time</label>
                                <InputDate class="form-control"
                                           Type="InputDateType.DateTimeLocal"
                                           @bind-Value="timeReportForm.StartTime" />
                            </div>

                            <div class="mb-3">
                                <label class="form-label">End Time</label>
                                <InputDate class="form-control"
                                           Type="InputDateType.DateTimeLocal"
                                           @bind-Value="timeReportForm.EndTime" />
                            </div>

                            <div class="mb-3">
                                <label class="form-label">Break (minutes)</label>
                                <InputNumber class="form-control"
                                             @bind-Value="timeReportForm.BreakMinutes" />
                            </div>

                            <div class="mb-3">
                                <label class="form-label">Description</label>
                                <InputTextArea class="form-control"
                                               @bind-Value="timeReportForm.Description" />
                            </div>

                            <button type="submit"
                                    class="	time-report-save-button"
                                    disabled="@isSubmittingTimeReport">
                                @(isSubmittingTimeReport ? "Registering..." : "Register Time Report")
                            </button>

                            <button type="button"
                                    class="	time-report-cancel-button"
                                    @onclick="CancelCreatingTimeReport"
                                    disabled="@isSubmittingTimeReport">
                                Cancel
                            </button>
                        </EditForm>
                    }
                    
                    @if (employee.TimeReports.Count == 0)
                    {
                        <p>No time reports registered.</p>
                    }
                    else
                    {
                        @foreach (var report in employee.TimeReports)
                        {
                            <div class="card mb-3 p-3">

                                <p><strong>Order Number:</strong> @report.BookingId</p>
                                <p><strong>Start:</strong> @report.StartTime.ToString("g")</p>
                                <p><strong>End:</strong> @report.EndTime.ToString("g")</p>
                                <p><strong>Break (minutes):</strong> @report.BreakMinutes</p>
                                <p><strong>Description:</strong> @report.Description</p>

                                @if (isAdministrator || isMyProfilePage)
                                {
                                    @if (editingTimeReportId == report.Id)
                                    {
                                        <EditForm Model="timeReportForm"
                                                  OnValidSubmit="UpdateTimeReportAsync"
                                                  Context="timeReportEditContext">

                                            <DataAnnotationsValidator />
                                            <ValidationSummary />

                                            <div class="mb-3">
                                                <label class="form-label">Order Number</label>
                                                <InputNumber class="form-control"
                                                             @bind-Value="timeReportForm.BookingId" />
                                            </div>

                                            <div class="mb-3">
                                                <label class="form-label">Start Time</label>
                                                <InputDate class="form-control"
                                                           Type="InputDateType.DateTimeLocal"
                                                           @bind-Value="timeReportForm.StartTime" />
                                            </div>

                                            <div class="mb-3">
                                                <label class="form-label">End Time</label>
                                                <InputDate class="form-control"
                                                           Type="InputDateType.DateTimeLocal"
