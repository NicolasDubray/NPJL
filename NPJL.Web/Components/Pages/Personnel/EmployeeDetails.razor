    // Registers a new salary period for the employee.
    private async Task SaveSalaryAsync()
    {
        if (!isAdministrator || employee == null)
        {
            return;
        }

        salaryErrorMessage = null;
        salaryMessage = null;

        // Validate salary amount and date range.
        if (salaryForm.Amount <= 0)
        {
            salaryErrorMessage = "Salary amount must be greater than zero.";
            return;
        }

        if (salaryForm.ValidTo.HasValue &&
            salaryForm.ValidTo.Value.Date < salaryForm.ValidFrom.Date)
        {
            salaryErrorMessage = "Valid To cannot be earlier than Valid From.";
            return;
        }

        isSavingSalary = true;

        try
        {
            var request = new CreateSalaryDto
            {
                Amount = salaryForm.Amount,
                ValidFrom = salaryForm.ValidFrom,
                ValidTo = salaryForm.ValidTo
            };

            await SalaryApiService.CreateAsync(employee.Id, request);

            // Refresh employee information after successful registration.
            employee = Id > 0
                ? await EmployeeApiService.GetDetailsAsync(Id)
                : await EmployeeApiService.GetMyDetailsAsync();

            isEditingSalary = false;
            salaryForm = new SalaryFormModel();

            salaryMessage = "Salary registered successfully.";
        }
        catch (HttpRequestException ex)
            when (ex.StatusCode == HttpStatusCode.Conflict)
        {
            salaryErrorMessage =
                "The salary period overlaps with an existing salary period.";
        }
        catch (HttpRequestException ex)
            when (ex.StatusCode == HttpStatusCode.Forbidden)
        {
            salaryErrorMessage =
                "You do not have permission to register salary information.";
        }
        catch (HttpRequestException)
        {
            salaryErrorMessage =
                "Could not register salary. Please check the API connection.";
        }
        catch (Exception)
        {
            salaryErrorMessage =
                "An unexpected error occurred while registering salary.";
        }
        finally
        {
            isSavingSalary = false;
        }
    }
    
