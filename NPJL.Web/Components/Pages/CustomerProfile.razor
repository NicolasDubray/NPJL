@page "/customerprofile"
@using Microsoft.AspNetCore.Components.Authorization
@using NPJL.Application.DTOs.Customers
@using NPJL.Application.DTOs.Invoices
@using NPJL.Application.Services
@using NPJL.Web.Services 
@rendermode InteractiveServer
@inject CustomerService CustomerService
@inject CurrentCustomerService CurrentCustomerService
@inject InvoiceService InvoiceService
@inject PaymentDetailsService PaymentDetailsService
@inject AuthenticationStateProvider AuthenticationStateProvider

<div class="container"> @* tillfälligt tills MainLayout är fixad. *@   

    <div class="row justify-content-center">
        <div class="col-12 col-lg-9">
            <h1 class="h1 mb-4 text-center">CustomerProfile</h1>

            <h3 class="h4">Customer information</h3>
            @if(customer != null)
            {
                <div class="card mb-4 shadow-sm">
                    <div class="card-body">
                        <table class="table table-striped table-hover table-bordered">
                            <thead>
                                <tr><th>Customer Number</th><th>Name</th><th>Email</th><th>Phone</th><th>Address</th></tr>
                            </thead>
                            <tbody>
                                <tr><td>@customer.Id</td><td>@customer.Name</td><td>@customer.ContactInfo?.Email</td><td>@customer.ContactInfo?.Telephone</td><td>@customer.ContactInfo?.Address</td></tr>
                            </tbody>
                        </table>
                    </div>
                </div>
            }
          
            
           

            <h3 class="h4">Pending invoices</h3>
            <div class="card mb-4 shadow-sm">
                <div class="card-body">
                <table class="table table-striped table-hover table-bordered">
                    <thead>
                        <tr><th>OCR</th><th>Amount</th><th>Send date</th><th>Expiry date</th><th>Status</th></tr>
                    </thead>

                    <tbody>
                        <tr>
                            <td>12345678</td><td>24970</td><td>2026-10-19</td><td>2026-11-25</td><td>Sent</td>
                        </tr>
                    </tbody>
                </table>
                </div>
            </div>

            <h3 class="h4">Invoice history</h3>
            <div class="card mb-4 shadow-sm">
                <div class="card-body">
                    <table class="table table-striped table-hover table-bordered">
                        <thead>
                            <tr><th>OCR</th><th>Amount</th><th>Send date</th><th>Expiry date</th><th>Status</th></tr>
                        </thead>
                        <tbody>
                            <tr>
                                <td>87654321</td>
                                <td>18500</td>
                                <td>2026-08-15</td>
                                <td>2026-09-15</td>
                                <td>Paid</td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>

            

          

            <h3 class="h4">Bank details</h3>
            <div class="card mb-4 shadow-sm">
                <div class="card-body">
                    <table class="table table-striped table-hover table-bordered">
                        <thead>
                            <tr><th>Payment method</th><th>Payment reference</th><th>Active</th></tr>
                        </thead>
                        <tbody>
                            <tr><td>Bank transfer</td><td>1234-5678901</td><td>Yes</td></tr>
                        </tbody>
                    </table>
                </div>
            </div>

        </div>

    </div>

</div>

@code {
    private CustomerDto? customer;
    private List<PaymentDetailsDto>? paymentDetails;
    private List<InvoiceDto>? invoices;

    protected override async Task OnInitializedAsync()
    {
        customer = await CurrentCustomerService.GetCurrentCustomerAsync();
        if (customer == null) return;
        paymentDetails = await PaymentDetailsService.GetByCustomerIdAsync(customer.Id);
        invoices = await InvoiceService.GetByCustomerIdAsync(customer.Id);
    }
}
