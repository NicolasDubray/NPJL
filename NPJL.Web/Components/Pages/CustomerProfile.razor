@page "/customerprofile"
@rendermode InteractiveServer

<div class="container"> @* tillfälligt tills MainLayout är fixad. *@   

    <div class="row justify-content-center">
        <div class="col-12 col-lg-7">
           <h1 class="h1 mb-4 text-center">CustomerProfile</h1>
            <h3 class="h4">Customer information</h3>
            <div class="card mb-4">
                <div class="card-body py-2 p-2">
                    <div class="d-flex">
                        <dl class="row mb-0">
                            <dt class="col-sm-4">Customer Number</dt>
                            <dd class="col-sm-8 fw-bold">Id</dd>
                            <dt class="col-sm-4">Name:</dt>
                            <dd class="col-sm-8 fw-bold">Anna Svensson</dd>
                            <dt class="col-sm-4">Email:</dt>
                            <dd class="col-sm-8 fw-bold">Anna@exempel.se</dd>
                            <dt class="col-sm-4">Phone:</dt>
                            <dd class="col-sm-8 fw-bold">0711111111</dd>
                            <dt class="col-sm-4">Address:</dt>
                            <dd class="col-sm-8 fw-bold">SverigeBästaGata 17B</dd>
                        </dl>
                    </div>
                </div>
            </div>
            <h3 class="h4 ">Ongoing orders</h3>
            <div class="card mb-4">
                <div class="card-body">
                    <table class="table">
                        <thead>
                            <tr>
                                <th>Order</th><th>Start</th><th>End</th><th>Status</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr>
                                <td>2</td><td>2026-07-10</td><td>2026-09-10</td><td>InProgress</td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
            <h3 class="h4">Pending invoices</h3>
            <div class="card mb-4">
                <div class="card-body">
                <table class="table">
                    <thead>
                        <tr><th>OCR</th><th>Amount</th><th>Send date</th><th>Expiry date</th><th>Status</th></tr>
                    </thead>

                    <tbody>
                        <tr>
                            <td>12345678</td><td>24970</td><td>2026-10-19</td><td>2026-11-25</td><td>Sent</td>
                        </tr>
                    </tbody>
                </table>
                </div>
            </div>
            <h3 class="h4">Order history</h3>
            <div class="card mb-4">
                <div class="card-body">
                    <table class="table">
                        <thead>
                            <tr><th>Order</th><th>Start</th><th>End</th><th>Status</th></tr>  
                        </thead>
                        <tbody>
                            <tr>
                            <td>1</td><td>2026-08-10</td><td>2026-10-10</td><td>Finished</td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>

            <h3 class="h4">Invoice history</h3>
            <div class="card mb-4">
                <div class="card-body">
                    <table class="table">
                        <thead>
                            <tr><th>OCR</th><th>Amount</th><th>Send date</th><th>Expiry date</th><th>Status</th></tr>
                        </thead>
                        <tbody>
                            <tr>
                                <td>87654321</td><td>18500</td><td>2026-08-15</td><td>2026-09-15</td><td>Paid</td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
            <h3 class="h4">Bank details</h3>
            <div class="card mb-4">
                <div class="card-body py-2 p-2">
                    <dl class="row mb-0">
                        <dt class="col-sm-4">Payment method:</dt>
                        <dd class="col-sm-8 fw-bold">Bank transfer</dd>
                        <dt class="col-sm-4">Payment reference:</dt>
                        <dd class="col-sm-8 fw-bold">1234-5678901</dd>
                        <dt class="col-sm-4">Active:</dt>
                        <dd class="col-sm-8 fw-bold">Yes</dd>
                    </dl>
                </div>
            </div>

        </div>

    </div>

</div>

